   306			.name = MLXBF_BOOTCTL_DRIVER_NAME,
   307			.groups = mlxbf_bootctl_attr_groups,
   308			.acpi_match_table = ACPI_PTR(mlxbf_bootctl_acpi_ids),
   309		}
   310	};
