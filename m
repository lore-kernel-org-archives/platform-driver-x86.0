>> index b848277..d48262c 100644
>> --- a/drivers/platform/x86/acer-wmi.c
>> +++ b/drivers/platform/x86/acer-wmi.c
>> @@ -105,6 +105,7 @@ static const struct key_entry acer_wmi_keymap[] = {
>>   	{KE_KEY, 0x22, {KEY_PROG2} },    /* Arcade */
